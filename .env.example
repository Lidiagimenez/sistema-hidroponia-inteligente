# Copiá este archivo como .env (NO se sube a Git) y completá los valores.
# Django lo lee de las variables de entorno; si no existen usa valores de desarrollo.

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
# En producción: DJANGO_DEBUG=0 y listar los dominios/IPs permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
