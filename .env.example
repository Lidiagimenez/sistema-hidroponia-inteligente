# Copiá este archivo como .env (NO se sube a Git) y completá los valores.
# En dev hay valores por defecto seguros para trabajo local. En prod son obligatorios.

DJANGO_ENV=dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
# En producción: DJANGO_DEBUG=0 y listar los dominios/IPs permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción: orígenes HTTPS confiables separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hidrosensor.example.com
# CSP opcional. Si no se define, se usa la política por defecto del proyecto.
DJANGO_CSP=
